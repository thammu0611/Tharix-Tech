# ─────────────────────────────────────────────────────────────
# Tharix Technologies — environment configuration
# Copy to `.env.local` and fill in real values. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.tharixtechnologies.com

# ── Contact form delivery ────────────────────────────────────
# Server-only. Where new project enquiries are delivered.
CONTACT_INBOX=hello@tharixtechnologies.com

# Transactional email provider key (Resend / Postmark / SendGrid …).
# The contact API route logs submissions until this is configured.
EMAIL_API_KEY=

# ── Spam protection ──────────────────────────────────────────
# Cloudflare Turnstile (or hCaptcha / reCAPTCHA) — optional but recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
